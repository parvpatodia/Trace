# ── Required for the Personal Context API (v2 — hackathon path) ──────────────
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Default model — change to gemini-2.5-pro for harder reasoning at higher cost.
GEMINI_MODEL=gemini-2.5-flash

# ── Optional: legacy newsletter pipeline (Claude-backed) ─────────────────────
# Leave empty to disable the newsletter path; the /v2 endpoints don't need it.
ANTHROPIC_API_KEY=

# ── Signal sources (at least one must be present or uploaded via web UI) ───────

# Chrome history: takeout.google.com → Chrome → BrowserHistory.json
BROWSER_HISTORY_PATH=./BrowserHistory.json

# YouTube watch history: takeout.google.com → YouTube and YouTube Music
#   → Takeout/YouTube and YouTube Music/history/watch-history.json
# Enables rewatch detection — 3+ views of same video = "stuck" curiosity signal
# YOUTUBE_WATCH_HISTORY_PATH=./watch-history.json

# ChatGPT conversations: ChatGPT Settings → Data Controls → Export Data
# CHATGPT_EXPORT_PATH=./conversations.json

# Local documents (.txt, .md, .pdf) to mine for curiosity signals
# FILESYSTEM_ROOT_DIR=~/Documents/notes

# ── Optional scrapers ─────────────────────────────────────────────────────────

# Reddit: create a script app at reddit.com/prefs/apps
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=

# Apify: free tier at apify.com ($5/month credits, no credit card required)
# Uses tri_angle/bing-search-scraper (compute-unit pricing — works on free tier)
# Do NOT use actors with monthly rental fees on the free tier.
# APIFY_API_TOKEN=
# APIFY_ACTOR_ID=tri_angle/bing-search-scraper

# ── Model settings ────────────────────────────────────────────────────────────
ANTHROPIC_MODEL=claude-sonnet-4-6

# ── Pipeline tuning ───────────────────────────────────────────────────────────
MAX_TOPICS=5
MAX_ARTICLES_PER_TOPIC=3
CONTEXT_TOKEN_BUDGET=8000
RECENCY_HALF_LIFE_DAYS=14
DEBT_OCCURRENCE_THRESHOLD=3
SCRAPER_MAX_CONCURRENT=5

# ── Storage ───────────────────────────────────────────────────────────────────
AUDIT_LOG_PATH=./trace_audit.jsonl
UPLOAD_DIR=./uploads

# ── Tigris Data (optional — S3-compatible globally distributed storage) ───────
# Sign up at tigrisdata.com — free tier available
# Uploads + Apify artifacts are mirrored to Tigris when configured
# TIGRIS_ACCESS_KEY_ID=
# TIGRIS_SECRET_ACCESS_KEY=
# TIGRIS_BUCKET_NAME=trace-curiosity
# TIGRIS_ENDPOINT_URL=https://fly.storage.tigris.dev

# ── Redis (optional — enables sub-50ms graph reads for MCP tools) ─────────────
# REDIS_URL=redis://localhost:6379

# ── Slack direct webhook (optional — Tier A alerts without Scalekit OAuth) ────
# Create an Incoming Webhook at api.slack.com/apps → Incoming Webhooks
# When set, pattern alerts fire immediately via POST without any OAuth setup.
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# ── Auth (optional — enables /auth/* endpoints via Scalekit) ─────────────────
# Scalekit free tier: 5,000 tool calls/month + unlimited dev environments
# Sign up at scalekit.com — dev environment is completely free, no quota
# SCALEKIT_ENV_URL=https://your-env.scalekit.com
# SCALEKIT_CLIENT_ID=
# SCALEKIT_CLIENT_SECRET=
# AUTH_CALLBACK_URL=http://localhost:8000/auth/callback

# ── Server ────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
