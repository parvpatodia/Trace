# ── Required ──────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Signal sources (at least one file must exist) ─────────────────────────────
# Path to BrowserHistory.json from Google Takeout (Chrome history export)
BROWSER_HISTORY_PATH=./BrowserHistory.json

# Optional: path to conversations.json from ChatGPT data export
# CHATGPT_EXPORT_PATH=./conversations.json

# Optional: local directory of .txt / .md / .pdf documents to mine
# FILESYSTEM_ROOT_DIR=~/Documents/notes

# ── Optional scrapers ─────────────────────────────────────────────────────────
# Reddit: create an app at reddit.com/prefs/apps (script type)
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=

# Apify: get a token at apify.com (uses bing-search-scraper actor)
# APIFY_API_TOKEN=

# ── Model settings ────────────────────────────────────────────────────────────
ANTHROPIC_MODEL=claude-sonnet-4-6-20251001

# ── Pipeline tuning ───────────────────────────────────────────────────────────
MAX_TOPICS=5
MAX_ARTICLES_PER_TOPIC=3
CONTEXT_TOKEN_BUDGET=8000
RECENCY_HALF_LIFE_DAYS=14
DEBT_OCCURRENCE_THRESHOLD=3
SCRAPER_MAX_CONCURRENT=5

# ── Storage ───────────────────────────────────────────────────────────────────
AUDIT_LOG_PATH=./trace_audit.jsonl
UPLOAD_DIR=./uploads

# ── Auth (optional — enables /auth/* endpoints) ───────────────────────────────
# SCALEKIT_ENV_URL=https://your-env.scalekit.com
# SCALEKIT_CLIENT_ID=
# SCALEKIT_CLIENT_SECRET=
# AUTH_CALLBACK_URL=http://localhost:8000/auth/callback

# ── Server ────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
